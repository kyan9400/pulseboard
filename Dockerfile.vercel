FROM python:3.14-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip wheel --wheel-dir /wheels .

FROM python:3.14-slim AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PULSEBOARD_ENVIRONMENT=production \
    PULSEBOARD_DATABASE_URL=sqlite+aiosqlite:////tmp/pulseboard.db \
    PULSEBOARD_ENABLE_SCHEDULER=false \
    PORT=8000
WORKDIR /app

RUN apt-get update \
    && apt-get upgrade --yes \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 pulseboard \
    && useradd --uid 1001 --gid pulseboard --create-home pulseboard
COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir /wheels/* \
    && python -m pip uninstall --yes pip setuptools \
    && rm -rf /wheels

USER pulseboard
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn pulseboard.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --proxy-headers"]
